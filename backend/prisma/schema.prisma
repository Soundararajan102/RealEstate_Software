generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_EXECUTIVE
  ACCOUNTS_EXECUTIVE
}

enum ProjectStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum PlotStatus {
  AVAILABLE
  BOOKED
  SOLD
}

enum Facing {
  NORTH
  SOUTH
  EAST
  WEST
  NORTH_EAST
  NORTH_WEST
  SOUTH_EAST
  SOUTH_WEST
}

enum PaymentPlan {
  FULL_PAYMENT
  INSTALLMENT
}

enum BookingStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CommissionType {
  PERCENTAGE
  FIXED_PER_SQFT
}

enum CommissionStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  UPI
}

enum SmsStatus {
  DELIVERED
  SIMULATED
  FAILED
}

enum SmsEventType {
  BOOKING_WELCOME
  PAYMENT_RECEIPT
  INSTALLMENT_REMINDER
  PROJECT_UPDATE
  CUSTOM
}

model User {
  id               String   @id @default(uuid())
  employeeId       String   @unique
  fullName         String
  email            String   @unique
  phone            String?
  passwordHash     String
  role             Role     @default(SALES_EXECUTIVE)
  isActive         Boolean  @default(true)
  assignedProjects String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookingsCreated  Booking[] @relation("SalesExecutiveBookings")
  paymentsRecorded Payment[] @relation("RecordedPayments")

  @@map("users")
}

model Project {
  id            String        @id @default(uuid())
  name          String
  location      String
  description   String?
  totalAreaSqFt Decimal?      @db.Decimal(12, 2)
  totalPlots    Int           @default(0)
  status        ProjectStatus @default(ONGOING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  plots Plot[]

  @@map("projects")
}

model Plot {
  id           String     @id @default(uuid())
  projectId    String
  plotNumber   String
  surveyNumber String?
  facing       Facing     @default(NORTH)
  dimension    String? // e.g. "30 x 40"
  areaSqFt     Decimal    @db.Decimal(10, 2)
  ratePerSqFt  Decimal    @db.Decimal(10, 2)
  totalPrice   Decimal    @db.Decimal(14, 2)
  isCornerPlot Boolean    @default(false)
  status       PlotStatus @default(AVAILABLE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([projectId, plotNumber])
  @@map("plots")
}

model Customer {
  id             String   @id @default(uuid())
  customerCode   String   @unique
  fullName       String
  phone          String   @unique
  alternatePhone String?
  email          String?
  address        String?
  idProofType    String? // e.g. Aadhaar, PAN, Voter ID
  idProofNumber  String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings Booking[]
  payments Payment[]
  smsLogs  SmsLog[]

  @@map("customers")
}

model Broker {
  id                     String         @id @default(uuid())
  brokerCode             String         @unique
  fullName               String
  phone                  String         @unique
  agencyName             String?
  email                  String?
  address                String?
  commissionType         CommissionType @default(PERCENTAGE)
  defaultCommissionValue Decimal        @default(1.0) @db.Decimal(8, 2) // e.g. 1% or 20 Rs/sqft
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  bookings Booking[]

  @@map("brokers")
}

model Booking {
  id                     String           @id @default(uuid())
  bookingCode            String           @unique
  customerId             String
  plotId                 String
  brokerId               String?
  salesExecutiveId       String
  bookingDate            DateTime         @default(now())
  agreedRatePerSqFt      Decimal          @db.Decimal(10, 2)
  agreedTotalPrice       Decimal          @db.Decimal(14, 2)
  discountAmount         Decimal          @default(0) @db.Decimal(12, 2)
  finalPayableAmount     Decimal          @db.Decimal(14, 2)
  bookingAdvancePaid     Decimal          @default(0) @db.Decimal(14, 2)
  paymentPlan            PaymentPlan      @default(FULL_PAYMENT)
  installmentCount       Int              @default(1)
  status                 BookingStatus    @default(ACTIVE)
  brokerCommissionAmount Decimal          @default(0) @db.Decimal(12, 2)
  brokerCommissionStatus CommissionStatus @default(PENDING)
  notes                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  customer       Customer              @relation(fields: [customerId], references: [id])
  plot           Plot                  @relation(fields: [plotId], references: [id])
  broker         Broker?               @relation(fields: [brokerId], references: [id])
  salesExecutive User                  @relation("SalesExecutiveBookings", fields: [salesExecutiveId], references: [id])
  installments   InstallmentSchedule[]
  payments       Payment[]
  smsLogs        SmsLog[]

  @@map("bookings")
}

model InstallmentSchedule {
  id                String            @id @default(uuid())
  bookingId         String
  installmentNumber Int
  dueDate           DateTime
  expectedAmount    Decimal           @db.Decimal(14, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(14, 2)
  status            InstallmentStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("installment_schedules")
}

model Payment {
  id                   String        @id @default(uuid())
  receiptNumber        String        @unique
  bookingId            String
  customerId           String
  recordedById         String
  paymentDate          DateTime      @default(now())
  amount               Decimal       @db.Decimal(14, 2)
  paymentMethod        PaymentMethod @default(CASH)
  transactionReference String? // Cheque No / UTR / UPI Ref
  chequeDate           DateTime?
  bankName             String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  booking    Booking  @relation(fields: [bookingId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])
  recordedBy User     @relation("RecordedPayments", fields: [recordedById], references: [id])
  smsLogs    SmsLog[]

  @@map("payments")
}

model SmsLog {
  id              String       @id @default(uuid())
  recipientPhone  String
  recipientName   String?
  customerId      String?
  bookingId       String?
  paymentId       String?
  eventType       SmsEventType @default(CUSTOM)
  messageBody     String
  status          SmsStatus    @default(SIMULATED)
  gatewayResponse String?
  sentAt          DateTime     @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  booking  Booking?  @relation(fields: [bookingId], references: [id])
  payment  Payment?  @relation(fields: [paymentId], references: [id])

  @@map("sms_logs")
}
