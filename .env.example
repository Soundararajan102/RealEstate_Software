# Database Configuration
# Local host connection: postgresql://postgres:root@localhost:5432/msp_real_estate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=msp_real_estate
# If host port 5432 is already in use by a local PostgreSQL service, set DB_PORT to 5433
DB_PORT=5432

# Backend Environment
JWT_SECRET=msp_super_secret_jwt_key_2026_durozen_real_estate
SMS_PROVIDER=SIMULATED
# Automatically seed initial demo data on container startup
RUN_SEED=true
FRONTEND_URL=http://localhost:3000

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:4000/api
